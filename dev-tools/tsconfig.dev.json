{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["es2022", "DOM"],
    "module": "es2015",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist/",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "types": ["chrome-types"]
  },
  "include": ["../src/**/*"]
}
